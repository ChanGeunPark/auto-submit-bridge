# 카공맵 어드민 자동 제보 브릿지 환경변수

# 어드민 페이지와 공유할 인증 토큰 (긴 랜덤 문자열 권장: 예) `openssl rand -hex 32`)
# Vercel의 NEXT_PUBLIC_BRIDGE_TOKEN 와 동일하게 설정해야 함
BRIDGE_TOKEN="랜덤 문자열"

# 브릿지가 listen할 포트 (기본 7332)
PORT=7332

# CORS 허용 origin (콤마 구분)
# 로컬 개발 + 배포 도메인 모두 추가
ALLOWED_ORIGINS=http://localhost:3000,https://www.xn--ob0bo0wy3p.com

# 사용할 CLI 에이전트: "claude" (기본) 또는 "codex"
AGENT=claude

# 동시 실행 작업 수 (기본 1)
CONCURRENCY=1

# CLI 실행 타임아웃 (밀리초, 기본 180000 = 3분)
TIMEOUT_MS=180000
